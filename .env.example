# Kopier til .env og fyll ut. .env er git-ignorert.

# --- E-postsending (Fase 4) ---
# Bruk et EGET sende-domene, ikke hoveddomenet rentoutbase.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=Embrik @ RentOutBase
FROM_EMAIL=embrik@mail.rentoutbase.com

# --- Innboks-overvåkning for svar (Fase 5) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Enrichment (valgfritt) ---
HUNTER_API_KEY=

# --- AI-klassifisering av svar (valgfritt, Fase 5) ---
ANTHROPIC_API_KEY=

# --- Booking ---
BOOKING_URL=https://cal.com/rentoutbase/intro

# --- Compliance ---
# Fysisk firmaadresse må stå i hver e-post.
COMPANY_POSTAL_ADDRESS=RentOutBase AS, <gateadresse>, <postnr> <sted>

# --- Tempo / deliverability (unngå søppelpost) ---
# Maks antall e-poster per dag totalt.
DAILY_SEND_LIMIT=40
# Maks per kjøring. Med cron hver time = jevnt drypp (5/time → ~35/dag).
# Sett til 1 for det aller roligste (1 i timen).
SEND_PER_RUN=5
# Sender kun mellom disse timene (lokal tid). 8–15.
SEND_WINDOW_START=8
SEND_WINDOW_END=15
